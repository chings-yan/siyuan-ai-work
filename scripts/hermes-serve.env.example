# Set these in the launcher environment. Values below are examples, never credentials.
HERMES_SERVE_COMMAND=
HERMES_SERVE_PORT=9119
HERMES_SERVE_TOKEN_FILE=
HERMES_SERVE_EXPECTED_INSTALL_ID=

# Bridge must use the same loopback service and token file.
SIYUAN_HERMES_SERVE_URL=http://127.0.0.1:9119
SIYUAN_HERMES_SERVE_TOKEN_FILE=
# Match Desktop's effective backend profile (remoteProfile if configured).
SIYUAN_HERMES_SERVE_PROFILE=default
