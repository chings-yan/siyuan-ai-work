# Optional process environment. Copy privately and set SIYUAN_BRIDGE_ENV_FILE to its path.
# Empty path entries mean portable user-directory defaults; no credentials belong here.
SIYUAN_BRIDGE_HOST=127.0.0.1
SIYUAN_BRIDGE_PORT=8782
SIYUAN_BRIDGE_DATA_DIR=
SIYUAN_BRIDGE_TOKEN_FILE=
HERMES_STUDIO_TOKEN_FILE=
SIYUAN_BRIDGE_BINDINGS_FILE=
SIYUAN_BRIDGE_BINDINGS_V2_FILE=
SIYUAN_EKKO_CONNECTION_FILE=
SIYUAN_EKKO_PENDING_DIR=
SIYUAN_BRIDGE_LOG=
SIYUAN_BRIDGE_LOCK=
# Optional configured loopback services; the same companion supports Serve, Studio and old sessions.
HERMES_STUDIO_URL=http://127.0.0.1:8748
SIYUAN_HERMES_SERVE_URL=http://127.0.0.1:9119
SIYUAN_HERMES_SERVE_TOKEN_FILE=
# Effective backend profile; match Desktop remoteProfile when explicitly configured.
SIYUAN_HERMES_SERVE_PROFILE=default
